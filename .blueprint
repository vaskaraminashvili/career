    - app/Models/Vacancy.php
models:
    Student: { first_name: json, last_name: json, status: boolean }
    Company: { title: json, director: json, address: json, description: json, email: string, status: boolean }
    Vacancy: { title: json, description: json, company_id: 'id foreign:companies', status: boolean, relationships: { belongsTo: Company } }
